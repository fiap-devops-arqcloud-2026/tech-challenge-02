# ==============================================================
# VARIÁVEIS DE AMBIENTE — ToggleMaster
# ==============================================================
# Este arquivo serve como REFERÊNCIA COMPLETA de todas as variáveis.
#
# Para uso LOCAL (Docker Compose):
#   cp .env.example .env
#   → use os valores da seção LOCAL
#
# Para AWS (Kubernetes/EKS):
#   → use os valores da seção AWS para preencher os Secrets e ConfigMaps
#   → os K8s Secrets e ConfigMaps ficam em infra/k8s/*/secret.yaml e configmap.yaml
# ==============================================================


# ==============================================================
# SEÇÃO 1 — APENAS LOCAL (Docker Compose)
# Estas variáveis SÓ são usadas pelo docker-compose.yaml.
# No Kubernetes/EKS elas não existem — cada serviço recebe
# suas configurações diretamente via Secret e ConfigMap.
# ==============================================================

# Portas mapeadas do container para o host (sua máquina)
AUTH_PORT=8001
FLAG_PORT=8002
TARGETING_PORT=8003
EVALUATION_PORT=8004
ANALYTICS_PORT=8005

# Credenciais do PostgreSQL local (criado pelo Docker Compose)
POSTGRES_USER=toggle
POSTGRES_PASSWORD=toggle

# Nomes dos bancos locais (usados pelo script de init do postgres-app)
AUTH_DB=auth_db
FLAGS_DB=flags_db
TARGETING_DB=targeting_db

# Endpoint do DynamoDB LOCAL (container dynamodb-local do Compose)
# NÃO use esta variável em produção — no AWS o boto3 detecta automaticamente
DYNAMODB_ENDPOINT=http://dynamodb-local:8000


# ==============================================================
# SEÇÃO 2 — COMPARTILHADAS (local E produção, mesmo valor)
# ==============================================================

# Chave mestra para criar novas chaves de API no auth-service
# Troque para um valor forte e secreto em produção
MASTER_KEY=admin-secreto-123

# Nome da tabela DynamoDB (mesmo nome no local e na AWS)
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# Região AWS — usada tanto para o DynamoDB Local quanto para AWS real
AWS_REGION=us-east-1


# ==============================================================
# SEÇÃO 3 — URLs DE BANCO DE DADOS
# LOCAL: apontam para os containers do Docker Compose
# AWS:   apontam para os endpoints RDS provisionados na AWS
# ==============================================================

# ── auth-service ──────────────────────────────────────────────
# LOCAL (Docker Compose):
AUTH_DATABASE_URL=postgres://toggle:toggle@postgres-auth:5432/auth_db
# AWS (RDS) — substitua pelo endpoint real após criar o RDS:
# AUTH_DATABASE_URL=postgres://toggle:SUA_SENHA@ENDPOINT_RDS_AUTH.us-east-1.rds.amazonaws.com:5432/auth_db

# ── flag-service ──────────────────────────────────────────────
# LOCAL:
FLAGS_DATABASE_URL=postgres://toggle:toggle@postgres-app:5432/flags_db
# AWS (RDS) — mesmo endpoint do RDS do targeting (mesmo servidor, banco diferente):
# FLAGS_DATABASE_URL=postgres://toggle:SUA_SENHA@ENDPOINT_RDS_APP.us-east-1.rds.amazonaws.com:5432/flags_db

# ── targeting-service ─────────────────────────────────────────
# LOCAL:
TARGETING_DATABASE_URL=postgres://toggle:toggle@postgres-app:5432/targeting_db
# AWS (RDS):
# TARGETING_DATABASE_URL=postgres://toggle:SUA_SENHA@ENDPOINT_RDS_APP.us-east-1.rds.amazonaws.com:5432/targeting_db


# ==============================================================
# SEÇÃO 4 — URLs DE SERVIÇOS INTERNOS
# LOCAL: usam o nome do container Docker (resolve pela rede toggle-net)
# AWS:   o Kubernetes resolve automaticamente pelo nome do Service
#        (os valores abaixo funcionam igual em ambos os ambientes)
# ==============================================================

AUTH_SERVICE_URL=http://auth-service:8001
FLAG_SERVICE_URL=http://flag-service:8002
TARGETING_SERVICE_URL=http://targeting-service:8003


# ==============================================================
# SEÇÃO 5 — REDIS
# LOCAL: container redis do Docker Compose
# AWS:   endpoint do cluster ElastiCache provisionado na AWS
# ==============================================================

# LOCAL:
REDIS_URL=redis://redis:6379
# AWS (ElastiCache) — substitua pelo endpoint real:
# REDIS_URL=redis://ENDPOINT_ELASTICACHE.cache.amazonaws.com:6379


# ==============================================================
# SEÇÃO 6 — AWS SQS (fila de mensagens)
# LOCAL: deixe vazio — os serviços detectam e desabilitam o SQS automaticamente
# AWS:   preencha com a URL real da fila criada no console AWS
# ==============================================================

# LOCAL: vazio (SQS desabilitado — evaluation e analytics detectam e ajustam)
AWS_SQS_URL=
# AWS — substitua pelo valor real após criar a fila SQS:
# AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/SEU_ACCOUNT_ID/togglemaster-events


# ==============================================================
# SEÇÃO 7 — CREDENCIAIS AWS (IAM)
# LOCAL: valores dummy (o SDK da AWS exige algo mesmo sem usar)
# AWS:   credenciais reais de um usuário IAM com permissões para SQS e DynamoDB
#
# COMO OBTER:
#   1. Acesse o console AWS → IAM → Usuários → Criar usuário
#   2. Adicione permissões: AmazonSQSFullAccess + AmazonDynamoDBFullAccess
#   3. Crie uma "Chave de acesso" e copie os valores abaixo
# ==============================================================

# LOCAL (dummy — necessário porque o SDK boto3 exige variáveis definidas)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AWS — substitua pelos valores reais do usuário IAM:
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY


# ==============================================================
# SEÇÃO 8 — ECR (repositório de imagens Docker na AWS)
# Necessário apenas para fazer o push das imagens ao ECR
# e para preencher os Deployments do Kubernetes
# ==============================================================

# ID da sua conta AWS (12 dígitos) — encontre no canto superior direito do console AWS
# AWS_ACCOUNT_ID=123456789012

# Região onde os repositórios ECR serão criados (normalmente a mesma do cluster)
# ECR_REGION=us-east-1

# URLs completas das imagens no ECR (formato: ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/REPO:TAG)
# Estas URLs vão nos arquivos infra/k8s/*/deployment.yaml no campo "image:"
# ECR_IMAGE_AUTH=123456789012.dkr.ecr.us-east-1.amazonaws.com/auth-service:latest
# ECR_IMAGE_FLAG=123456789012.dkr.ecr.us-east-1.amazonaws.com/flag-service:latest
# ECR_IMAGE_TARGETING=123456789012.dkr.ecr.us-east-1.amazonaws.com/targeting-service:latest
# ECR_IMAGE_EVALUATION=123456789012.dkr.ecr.us-east-1.amazonaws.com/evaluation-service:latest
# ECR_IMAGE_ANALYTICS=123456789012.dkr.ecr.us-east-1.amazonaws.com/analytics-service:latest


# ==============================================================
# SEÇÃO 9 — SERVICE API KEY
# Chave criada no auth-service que o evaluation-service usa
# para se autenticar no flag-service e targeting-service
#
# LOCAL: gerada durante os testes locais (POST /admin/keys)
# AWS:   deve ser gerada novamente após o deploy em produção
#        (o banco RDS começa vazio — a chave local não existe lá)
# ==============================================================

# LOCAL (gerada nos testes):
SERVICE_API_KEY=tm_key_2ac5a985a50b8f8d350e66aa8b19061dd06ae3096e08ab7c7fac1d306137c5b2

# AWS — após o deploy, crie uma nova chave:
#   curl -X POST https://SEU_LOAD_BALANCER/admin/keys \
#     -H "Authorization: Bearer SUA_MASTER_KEY" \
#     -d '{"name": "evaluation-service-prod"}'
# Cole o valor retornado aqui e atualize o Secret do Kubernetes:
# SERVICE_API_KEY=tm_key_NOVA_CHAVE_PRODUCAO
