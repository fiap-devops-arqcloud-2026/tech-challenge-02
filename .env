# --- PORTAS (host) ---
AUTH_PORT=8001
FLAG_PORT=8002
TARGETING_PORT=8003
EVALUATION_PORT=8004
ANALYTICS_PORT=8005

# --- POSTGRES (credenciais locais) ---
POSTGRES_USER=toggle
POSTGRES_PASSWORD=toggle
AUTH_DB=auth_db
FLAGS_DB=flags_db
TARGETING_DB=targeting_db

# --- AUTH ---
MASTER_KEY=admin-secreto-123
AUTH_DATABASE_URL=postgres://toggle:toggle@postgres-auth:5432/auth_db
FLAGS_DATABASE_URL=postgres://toggle:toggle@postgres-app:5432/flags_db
TARGETING_DATABASE_URL=postgres://toggle:toggle@postgres-app:5432/targeting_db

# --- URLs internas (Docker network / Compose) ---
AUTH_SERVICE_URL=http://auth-service:8001
FLAG_SERVICE_URL=http://flag-service:8002
TARGETING_SERVICE_URL=http://targeting-service:8003
REDIS_URL=redis://redis:6379

# --- AWS SQS ---
# LOCAL: vazio — os serviços detectam e desabilitam o SQS automaticamente
# AWS:   preencha com a URL real da fila após criá-la no console AWS
AWS_SQS_URL=

# --- CREDENCIAIS AWS ---
# LOCAL: valores dummy — o SDK boto3 exige que as variáveis existam, mesmo sem usar SQS real
# AWS:   substitua pelas credenciais reais do usuário IAM
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- SERVICE API KEY (o evaluation-service precisa para chamar flag/targeting) ---
SERVICE_API_KEY=tm_key_7eef1fe38ae0571c1f17a6c6388d146b98edf8838e2a76c1ad4f583530c614b1

# --- DYNAMODB LOCAL ---
AWS_REGION=us-east-1
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics
DYNAMODB_ENDPOINT=http://dynamodb-local:8000